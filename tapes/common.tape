# Shared settings for ntactor demo recordings.
Set Shell /bin/sh
Env ENV ""
Env PS1 "ntactor> "
Env COLORTERM "truecolor"
Env CLICOLOR_FORCE "1"
Set FontFamily "Go Mono"
Set FontSize 14
Set Columns 166
Set Rows 35
Set Theme "Catppuccin Mocha"
Set Padding 16
Set Margin 10
Set MarginFill "#11111b"
Set WindowBar Colorful
Set BorderRadius 10
Set Framerate 12
Set TypingSpeed 80ms
Set WaitTimeout 20s
